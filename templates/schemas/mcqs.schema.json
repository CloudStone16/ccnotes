{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ccnotes mcqs",
  "type": "object",
  "required": ["sectionChecks", "isa"],
  "additionalProperties": false,
  "definitions": {
    "mcq": {
      "type": "object",
      "required": ["id", "stem", "options", "answer", "explanation"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stem": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "answer": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "section": { "type": "integer", "minimum": 1 },
        "conceptRef": { "type": "string" },
        "why": { "type": "string" }
      }
    }
  },
  "properties": {
    "sectionChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "items"],
        "additionalProperties": false,
        "properties": {
          "section": { "type": "integer", "minimum": 1 },
          "items": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "$ref": "#/definitions/mcq" } }
        }
      }
    },
    "isa": {
      "type": "object",
      "required": ["mark1", "mark2"],
      "additionalProperties": false,
      "properties": {
        "mark1": { "type": "array", "items": { "$ref": "#/definitions/mcq" } },
        "mark2": { "type": "array", "items": { "$ref": "#/definitions/mcq" } }
      }
    }
  }
}
