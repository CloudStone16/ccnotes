{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ccnotes flashcards",
  "type": "object",
  "required": ["deck"],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "front", "back", "section", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^fc-[0-9]{3,}$" },
          "front": { "type": "string", "minLength": 1 },
          "back": { "type": "string", "minLength": 1 },
          "section": { "type": "integer", "minimum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "kind": { "enum": ["concept", "definition", "formula", "distinction", "procedure"] }
        }
      }
    }
  }
}
