{
  "name": "ccnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local interactive study-notes platform. Coding agents (Codex, Claude Code, Gemini CLI, Antigravity) build dark-mode interactive HTML notes from slide decks; this server browses them.",
  "scripts": {
    "start": "node server.mjs",
    "setup": "node scripts/setup-vendor.mjs && node tools/sync-skills.mjs",
    "scan": "node tools/scan.mjs --print",
    "validate": "node tools/validate-all.mjs",
    "new": "node tools/new-notebook.mjs",
    "delete": "node tools/delete-notebook.mjs",
    "sync-skills": "node tools/sync-skills.mjs",
    "setup:codex": "node tools/sync-skills.mjs",
    "check:agent-skills": "node tools/sync-skills.mjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
