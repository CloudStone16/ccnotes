# --- dependencies / vendored assets (fetched by `npm run setup`) ---
node_modules/
viewer/note-kit/vendor/*
!viewer/note-kit/vendor/.gitkeep

# --- OS / editor cruft ---
.DS_Store
**/.DS_Store
*.log

# --- your source slide decks (never published) ---
/inbox/*
!/inbox/.gitkeep

# --- generated study-notes content (personal; rebuilt from your decks) ---
/content/*
!/content/.gitkeep

# --- generated per-notebook doubt-clarifier skills (rebuilt by ccnotes-build) ---
/.claude/skills/ccnotes-doubt-*/

# --- .agents/skills/ is generated from .claude/skills/ by `npm run setup`
#     (mirror for Antigravity); never edit or commit it — edit .claude/skills/ ---
/.agents/skills/

# --- local machine state ---
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.agents/settings.local.json
/.agents/*.lock
/tmp/
